      "x": 1220,
      "y": 612,
      "width": 500,
      "height": 214,
      "text": "SQLITE DATABASE  ·  .data/photos.sqlite\nsettings(key, value)\nsessions(hash, expires)\npairs(hash, account, label)\nitems(id, account, media_key, data,\n      decision, revision, album_key, state, checked_at)\njobs(id, account, data, status, error,\n     album_key, created, updated)\nIndex: items(account)",
      "originalText": "SQLITE DATABASE  ·  .data/photos.sqlite\nsettings(key, value)\nsessions(hash, expires)\npairs(hash, account, label)\nitems(id, account, media_key, data,\n      decision, revision, album_key, state, checked_at)\njobs(id, account, data, status, error,\n     album_key, created, updated)\nIndex: items(account)",
