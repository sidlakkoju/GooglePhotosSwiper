{
 "manifest_version":3,"name":"Photos Swipe — Desktop Bridge","version":"1.3.0","minimum_chrome_version":"120",
 "description":"Pair Google Photos with your local Photos Swipe app. Review candidates in an album and upload verified video crops; no deletion permissions or commands.",
 "permissions":["scripting","storage"],
 "host_permissions":["https://photos.google.com/*","https://*.googleusercontent.com/*","https://photos.fife.usercontent.google.com/*","http://localhost/*"],
 "background":{"service_worker":"background.js","type":"module"},
 "action":{"default_popup":"popup.html","default_title":"Pair Photos Swipe"},
 "content_scripts":[{"matches":["http://localhost/*"],"js":["relay.js"],"run_at":"document_start"}]
}
